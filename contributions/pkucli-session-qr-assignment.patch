+        let wide = windows_path(path).unwrap();
+        assert_eq!(wide.last(), Some(&0));
+        assert_eq!(
+            String::from_utf16(&wide[..wide.len() - 1]).unwrap(),
+            path.to_str().unwrap()
+        );
+    }
+
+    #[test]
