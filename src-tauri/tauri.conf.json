{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OnePKU",
  "version": "0.1.0",
  "identifier": "me.petertian.onepku",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "OnePKU",
        "width": 1320,
        "height": 880,
        "minWidth": 760,
        "minHeight": 600,
        "backgroundColor": "#ffffff"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.pku.edu.cn; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; media-src 'self' blob: http://127.0.0.1:*; font-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJENkQ4MjlENUY5Q0FDMjgKUldRb3JKeGZuWUp0TFF1OG81ZERFWDNqZHI2Ym5POGxNdWdRcWdTWlNRdExHdWRvQ2cvV05pcXcK",
      "endpoints": [
        "https://github.com/PeterTianbuhan/onePKU/releases/latest/download/latest.json"
      ]
    }
  }
}
